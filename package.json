{
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "doctor": "react-doctor -y --offline --blocking warning --verbose --project web",
    "format:check": "prettier --check . '!{apps,packages}/**' && turbo format:check",
    "format:fix": "prettier --write . '!{apps,packages}/**' && turbo format:fix",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@ianvs/prettier-plugin-sort-imports": "catalog:",
    "@universe/eslint-config": "workspace:*",
    "@universe/typescript-config": "workspace:*",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "react-doctor": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": "26.2.0",
    "pnpm": "11.5.0"
  },
  "engineStrict": true
}
