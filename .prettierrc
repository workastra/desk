{
  "endOfLine": "lf",
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "printWidth": 100,
  "useTabs": false,
  "quoteProps": "as-needed",
  "arrowParens": "always",
  "jsxSingleQuote": true,
  "plugins": ["prettier-plugin-tailwindcss", "@ianvs/prettier-plugin-sort-imports"],
  "tailwindStylesheet": "packages/x-shadcn/src/styles/globals.css",
  "tailwindFunctions": ["cn", "cva"],
  "importOrder": [
    "server-only",
    "<BUILTIN_MODULES>",
    "^react",
    "^next",
    "<THIRD_PARTY_MODULES>",
    "^@universe/(?!.*\\.css$)(.*)$",
    "^#(?!.*\\.css$)(.*)$",
    "^.*\\.css$"
  ],
  "importOrderSafeSideEffects": ["^.*\\.css$"],
  "importOrderCaseSensitive": true
}
