# Public application version exposed to the browser
NEXT_PUBLIC_APP_VERSION=development

# The public base URL of your frontend application
APP_URL=http://localhost:3000

# Primary encryption key for sessions and secure payloads
APP_KEY=replace-with-a-long-random-secret

# Optional previous encryption keys for key rotation.
# Use comma-separated values, for example: old-key-1,old-key-2
APP_PREVIOUS_KEYS=

# The URL of your Identity Provider (e.g., OAuth/OpenID issuer)
# URL used by external clients (browsers, mobile apps, third-party services) to discover
# and validate JWT tokens via OIDC. Must be publicly reachable.
IAM_EXTERNAL_ISSUER_URL=http://localhost:9000

# URL used internally within the Kubernetes cluster for service-to-service communication.
# Uses k8s DNS format: <service>.<namespace>.svc.cluster.local to avoid routing
# traffic through the public internet (avoids hairpin).
IAM_INTERNAL_ISSUER_URL=workastra-iam.workastra.svc.cluster.local:9000

# Skip TLS certificate verification when connecting to the IAM server (true/false)
IAM_TLS_SKIP_VERIFY=true

# OAuth client ID registered with your Identity Provider
IAM_OAUTH_CLIENT_ID=workastra-desk

# OAuth client secret registered with your Identity Provider
IAM_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret

# Lock mode controls how exclusive execution is handled.
#
# in-memory   : In-process async mutex (single Node.js instance only)
# distributed : Distributed lock using external backend (Redis or Postgres)
LOCK_MODE=in-memory
